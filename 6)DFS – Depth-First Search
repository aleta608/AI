maze = [
    ['S', '.', '#', '.'],
    ['.', '.', '#', '.'],
    ['#', '.', '.', '.'],
    ['.', '#', '#', 'G']
]

start = (0, 0)
goal = (3, 3)

stack = [start]
visited = set()
parent = {start: None}

directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]

while stack:
    r, c = stack.pop()

    if (r, c) == goal:
        break

    if (r, c) not in visited:
        visited.add((r, c))

        for dr, dc in directions:
            nr = r + dr
            nc = c + dc

            if (0 <= nr < 4 and 0 <= nc < 4 and
                maze[nr][nc] != '#' and
                (nr, nc) not in visited):

                stack.append((nr, nc))
                parent[(nr, nc)] = (r, c)

path = []
node = goal

while node is not None:
    path.append(node)
    node = parent.get(node)

path.reverse()

if path[0] == start:
    print("Path found:")
    print(path)
else:
    print("No path found")
