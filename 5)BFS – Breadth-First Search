from collections import deque

grid = [
    ['S', '.', '.', '#'],
    ['.', '#', '.', '.'],
    ['.', '.', '.', '.'],
    ['#', '.', '#', 'G']
]

start = (0, 0)
goal = (3, 3)

q = deque([start])
visited = {start}
parent = {start: None}

directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]

while q:
    r, c = q.popleft()

    if (r, c) == goal:
        break

    for dr, dc in directions:
        nr = r + dr
        nc = c + dc

        if (0 <= nr < 4 and 0 <= nc < 4 and
            grid[nr][nc] != '#' and
            (nr, nc) not in visited):

            q.append((nr, nc))
            visited.add((nr, nc))
            parent[(nr, nc)] = (r, c)

path = []
node = goal

while node is not None:
    path.append(node)
    node = parent.get(node)

path.reverse()

if path[0] == start:
    print("Path found:")
    print(path)
else:
    print("No path found")
