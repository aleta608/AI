import random

responses = {
    'hello': ['hi', 'hello', 'hii'],
    'order': ['You can order from order section'],
    'refund': ['Refund will be given in 5 days'],
    'cancel': ['Click cancel button'],
    'bye': ['Goodbye!', 'bye!']
}

print("Say bye to exit")

while True:
    user = input("You: ").lower()

    if 'bye' in user:
        print("AI:", random.choice(responses['bye']))
        break

    elif 'hello' in user:
        print("AI:", random.choice(responses['hello']))

    elif 'order' in user:
        print("AI:", random.choice(responses['order']))

    elif 'refund' in user:
        print("AI:", random.choice(responses['refund']))

    elif 'cancel' in user:
        print("AI:", random.choice(responses['cancel']))

    else:
        print("No AI Response")
